// ════════════════════════════════════════════════════════════════════════════
// Leisure Exporting LLC · CRM — Esquema Prisma
// Multi-agencia: matriz → agencias → subagencias. Aislamiento estricto por
// agencia salvo el administrador (matriz), que ve el consolidado.
//
// Provider: SQLite en desarrollo (file:./dev.db), PostgreSQL en producción.
// ════════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ─── Agencias ────────────────────────────────────────────────────────────────
// Jerarquía: matriz → agencia (padreId=matriz) → subagencia (padreId=agencia).
// puedeCrearSubagencias: permiso que concede ÚNICAMENTE el admin.
model Agencia {
  id                   String   @id @default(cuid())
  nombre               String
  tipo                 String   @default("agencia") // matriz | agencia | subagencia
  padreId              String?  // null para matriz
  direccion            String?
  ciudad               String?
  pais                 String?
  telefono             String?
  puedeCrearSubagencias Boolean @default(false)
  contabilidadActiva   Boolean  @default(false)
  activa               Boolean  @default(true)
  creado               DateTime @default(now())

  padre                Agencia?  @relation("AgenciaJerarquia", fields: [padreId], references: [id])
  hijos                Agencia[] @relation("AgenciaJerarquia")
  usuarios             Usuario[]
  clientes             Cliente[]
  paquetes             Paquete[]
  asientos             Asiento[]

  @@index([tipo])
  @@index([padreId])
}

// ─── Usuarios ────────────────────────────────────────────────────────────────
model Usuario {
  id           String   @id @default(cuid())
  usuario      String   @unique // login, minúsculas
  passwordHash String
  nombre       String
  rol          String   @default("operario") // admin | agencia | operario | camionero
  agenciaId    String?
  activo       Boolean  @default(true)
  creado       DateTime @default(now())

  agencia      Agencia?  @relation(fields: [agenciaId], references: [id])
  paquetesCreados Paquete[] @relation("PaqueteCreadoPor")
  eventos      Evento[]

  @@index([agenciaId])
}

// ─── Clientes ────────────────────────────────────────────────────────────────
model Cliente {
  id        String   @id @default(cuid())
  nombre    String
  telefono  String?
  email     String?
  direccion String?
  agenciaId String
  creado    DateTime @default(now())

  agencia   Agencia @relation(fields: [agenciaId], references: [id])
  paquetes  Paquete[]

  @@index([agenciaId])
}

// ─── Paquetes ────────────────────────────────────────────────────────────────
// codigo = LXE + dígitos (único). Generado por secuencia segura en codigo.ts.
model Paquete {
  codigo        String   @id
  agenciaId     String
  clienteId     String?

  // Remitente (origen)
  remitente       String   @default("—")
  remitenteCarnet String?  // carnet/pasaporte del remitente
  remitenteTel    String?  // teléfono del remitente
  remitenteDir    String?  // dirección del remitente

  // Consignatario (destino) — datos detallados en Cuba
  destinatario    String   @default("—")
  consignatarioCarnet String? // carnet de identidad / pasaporte del que recibe
  consignatarioTel    String? // teléfono del que recibe
  consignatarioCalle  String? // calle y número
  consignatarioEntre  String? // entre calles
  consignatarioMunicipio String? // municipio
  consignatarioProvincia String? // provincia
  consignatarioCp     String? // código postal (opcional)

  destino         String   @default("—")
  peso            Float    @default(0)  // en libras
  pesoKg          Float?   // calculado: peso * 0.453592
  piezas          Int      @default(1)  // número de piezas/bultos
  bultos          Int      @default(0)  // bultos (igual a piezas en la mayoría)
  alto            Float?   // alto (pulgadas) — opcional
  largo           Float?   // largo (pulgadas) — opcional
  ancho           Float?   // ancho (pulgadas) — opcional
  volumenM3       Float?   // volumen en metros cúbicos (m³) — se calcula de alto×largo×ancho
  volumenFt3      Float?   // volumen en pies cúbicos (ft³) — se calcula de alto×largo×ancho
  contenido       String   @default("Paquete")
  categoria       String?  // ej: Comida, Ropa, Electrdoméstico, Medicina, Otro
  clasificacion   String?  // clasificación arancelaria
  mercancias      String?  // descripción de mercancías
  palet           String?  // identificación de palet
  hawb            String?  // House Air Waybill (guía aérea)
  guiaBuque       String?  // guía / nombre del buque
  manifiesto      Boolean  @default(false) // incluido en manifiesto
  escaneado       Boolean  @default(false) // fue escaneado
  factura         String?  // número de factura
  valorFact       Float?   // valor según factura
  valorDocum      Float?   // valor documental
  valor           Float?   // valor declarado
  valorPelig      Float?   // valor de mercancía peligrosa
  pagado          Boolean  @default(false) // pagado
  observaciones   String   @default("")
  imagen          String?  // URL de imagen/foto
  notas           String   @default("")
  tarifa          Float    @default(0)
  monto           Float    @default(0)
  estado          String   @default("en_origen") // en_origen|en_transito|en_almacen|entregado
  creado          DateTime @default(now())
  creadoPorId     String?
  ultimoEscaneo   DateTime?

  agencia       Agencia  @relation(fields: [agenciaId], references: [id])
  cliente       Cliente? @relation(fields: [clienteId], references: [id])
  creadoPor     Usuario? @relation("PaqueteCreadoPor", fields: [creadoPorId], references: [id])
  eventos       Evento[]
  asientos      Asiento[]
  equipos       EquipoDuradero[]

  @@index([agenciaId])
  @@index([estado])
  @@index([clienteId])
}

// ─── Equipos duraderos (electrodomésticos dentro de un paquete) ──────────────
// Cada equipo tiene tipo, marca, modelo, serial, valor y peso.
// La consulta de aduana verifica cuántos de cada tipo lleva el consignatario.
model EquipoDuradero {
  id            String   @id @default(cuid())
  paqueteCodigo String
  tipo          String   // ej: nevera, cocineta, lavadora, tv, microondas, etc.
  marca         String?
  modelo        String?
  serial        String?
  valor         Float    @default(0)  // valor declarado en USD
  peso          Float    @default(0)  // peso en kg
  creado        DateTime @default(now())

  paquete       Paquete  @relation(fields: [paqueteCodigo], references: [codigo], onDelete: Cascade)

  @@index([paqueteCodigo])
  @@index([tipo])
}

// ─── Eventos (historial GPS de cada paquete) ─────────────────────────────────
model Evento {
  id            String   @id @default(cuid())
  paqueteCodigo String
  ts            DateTime @default(now())
  estado        String
  nota          String   @default("")
  operarioId    String?
  lat           Float?
  lng           Float?
  accuracy      Float?

  paquete       Paquete  @relation(fields: [paqueteCodigo], references: [codigo], onDelete: Cascade)
  operario      Usuario? @relation(fields: [operarioId], references: [id])

  @@index([paqueteCodigo])
  @@index([estado])
}

// ─── Asientos contables (doble entrada) ──────────────────────────────────────
// lineas: JSON [{ cuenta, debito, credito }]
model Asiento {
  id            String   @id @default(cuid())
  fecha         DateTime @default(now())
  agenciaId     String?
  paqueteCodigo String?
  descripcion   String   @default("")
  lineas        String   @default("[]") // JSON serializado
  cuadrado      Boolean  @default(true)

  agencia       Agencia? @relation(fields: [agenciaId], references: [id])
  paquete       Paquete? @relation(fields: [paqueteCodigo], references: [codigo])

  @@index([agenciaId])
  @@index([paqueteCodigo])
  @@index([fecha])
}

// ─── Configuración (key/value) ───────────────────────────────────────────────
model Config {
  key   String @id
  value String
}
